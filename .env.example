# BumpOne.lol Environment Configuration

# 1. Supabase (Database, Auth, and War Room Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. Dodo Payments (Merchant of Record / Hosted Checkout)
DODO_PAYMENTS_API_KEY=test_your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_your_dodo_webhook_signing_secret
# Environment: 'test_mode' | 'live_mode'
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Base product or fallback pricing ID
DODO_PRODUCT_ID=p_bumped_top_up

# 3. Cloudflare R2 (Zero-Egress Object Storage for Profile Graphics)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=bumped-assets
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.bumpone.lol

# 4. App & Admin Security
APP_URL=https://bumpone.lol
ANON_COOKIE_SECRET=replace-with-a-long-random-secret
CRON_SECRET=your_cron_secret_key
# 5. Search Engine & SEO Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-search-console-verification-code

